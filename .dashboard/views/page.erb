<%== header(state, repo:) %>
<main class="main">
  <nav class="list" aria-label="Worktrees">
    <div class="list-head muted" aria-hidden="true">
      <span>worktree</span><span>branch</span><span>stack</span><span>PR</span><span>svc</span><span>agent</span>
    </div>
    <div id="worktrees" class="rows">
      <% state.worktrees.each do |wt| %>
<%== row(wt, selected: wt.name == selected&.name) %>
      <% end %>
    </div>
    <% if state.worktrees.empty? %>
    <p class="muted empty-list">loading worktrees…</p>
    <% end %>
  </nav>
  <% if selected %>
<%== detail(selected, state) %>
  <% else %>
  <section id="detail" class="detail empty"><p class="muted">no worktree selected</p></section>
  <% end %>
</main>
<section class="panel" aria-label="Actions">
  <details open>
    <summary>actions</summary>
    <div id="actions" class="jobs"></div>
  </details>
</section>
