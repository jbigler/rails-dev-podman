# frozen_string_literal: true

require "rake/testtask"

Rake::TestTask.new(:test) do |t|
  t.libs << "test" << "lib"
  t.test_files = FileList["test/**/*_test.rb"]
end

desc "Replay hook payloads through .container-config/claude-status-hook.sh"
task :hook do
  sh "sh", "test/hook/test-claude-status-hook.sh"
end

task default: %i[test hook]
